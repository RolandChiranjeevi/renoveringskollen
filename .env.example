# Lyssnar bara lokalt som standard. Sätt HOST=0.0.0.0 för att nå appen från andra enheter
# – men bara bakom HTTPS (se README, "Nå appen från andra enheter").
HOST=127.0.0.1
PORT=3100
DATABASE_PATH=./data/renoveringskollen.db
UPLOADS_DIR=./uploads

# Sätt till true när appen nås via HTTPS, så skickas inloggningscookien aldrig okrypterat.
COOKIE_SECURE=false
# Sätt till true bakom en omvänd proxy (Tailscale Serve, Caddy), så ser servern rätt klient-IP.
TRUST_PROXY=false
# Första start (skapa ägarkontot) får bara göras från datorn där appen körs. Ändra inte i onödan.
SETUP_ALLOW_REMOTE=false
